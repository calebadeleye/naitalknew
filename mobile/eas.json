{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true },
      "env": { "EXPO_PUBLIC_GREENMAIL_API": "https://www.naitalk.com/api/v1/greenmail" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_GREENMAIL_API": "https://www.naitalk.com/api/v1/greenmail" }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_GREENMAIL_API": "https://www.naitalk.com/api/v1/greenmail" }
    }
  },
  "submit": {
    "production": {}
  }
}
